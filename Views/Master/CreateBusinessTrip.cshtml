<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        html { font-size: 14px; }
        .select2-container .select2-selection--single {
            height: calc(1.5em + .75rem + 2px);
            border: 1px solid #d1d3e2;
            border-radius: 0.35rem;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: calc(1.5em + .75rem);
            color: #6e707e;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: calc(1.5em + .75rem);
        }
        .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
        .action-btns a:hover { opacity: 0.7; }
        .action-btns .fa-trash-alt { color: #e74a3b; }
        .page-title-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }
        .page-title-text {
            font-size: 0.85rem;
            font-weight: 800;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .form-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
        .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
        
        .card-header-custom {
            background-color: #4e73df;
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.85rem;
            padding: 10px 15px;
        }
        .summary-panel {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            color: white;
            border-radius: 0.35rem;
            padding: 10px 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .summary-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            font-weight: bold;
            opacity: 0.9;
            margin-bottom: 2px;
        }
        .summary-val {
            font-size: 1.1rem;
            font-weight: bold;
        }
        

        
        .number-align {
            text-align: right;
        }
        input[type="text"], textarea, select { text-align: left; }
        .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
            background-color: #e9ecef !important; 
            opacity: 1; 
        }
        .flatpickr-input[readonly], .datepicker[readonly] {
            background-color: #ffffff !important;
            opacity: 1 !important;
        }
        .table th, .table td { vertical-align: middle; }
        .table td.num-col { text-align: right; }
    </style>
<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-plane fa-sm text-primary mr-2"></i> Create Business Trip
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("BusinessTripIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" onclick="saveBusinessTrip()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> <span id="save-btn-label">Save</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="tripForm" autocomplete="off">
        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Select Employee...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly />
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Currency <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-currency" required>
                            <option value="">Select Currency...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Exchange Rate</label>
                        <input type="number" class="form-control number-align" id="hdr-exrate" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Payment Type <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-paymenttype" required>
                            <option value="In Payroll">In Payroll</option>
                            <option value="Settlement">Settlement</option>
                        </select>
                    </div>
                    
                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- TRIP DETAILS CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom bg-info">Trip Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">From Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control datepicker calc-trigger" id="dtl-fromdate" required />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">To Date <span class="text-danger">*</span></label>
                        <input type="text" class="form-control datepicker calc-trigger" id="dtl-todate" required />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Duration</label>
                        <input type="number" class="form-control number-align" id="dtl-duration" readonly />
                    </div>
                    <div class="col-md-4 mb-3"></div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">From City <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-fromcity" required>
                            <option value="">Select From City...</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">To City <span class="text-danger">*</span></label>
                        <select class="form-control calc-trigger" id="dtl-tocity" required>
                            <option value="">Select To City...</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Rate</label>
                        <input type="text" class="form-control number-align" id="dtl-rate" readonly />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Amount</label>
                        <input type="text" class="form-control number-align" id="dtl-amount" readonly />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="dtl-remarks" />
                    </div>
                    
                    <div class="col-md-4 text-right mt-2 d-flex align-items-end justify-content-end mb-3">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SUMMARY PANEL -->
        <div class="summary-panel mb-4 text-center">
            <div class="summary-label">Total Trip Amount</div>
            <div class="summary-val"><span id="sum-currency"></span> <span id="sum-amount">0.00</span></div>
        </div>
    </form>

    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary">Trip Detailed</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th>Dates</th>
                            <th>Duration</th>
                            <th>From City</th>
                            <th>To City</th>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    var employeesData = [];
    var currencyData = [];
    var cityData = [];
    var rateMatrix = [];
    var stagedTrips = [];

    // Edit mode: ?idx=<array index into savedBusinessTrips> means "edit this existing record"
    // instead of creating a new one — navigated to directly from BusinessTripIndex's Edit link
    // (a plain page link now, no modal/sessionStorage handoff) exactly like CreateLeaveApplication's
    // own ?id= pattern.
    var urlParams = new URLSearchParams(window.location.search);
    var editIdx = urlParams.has('idx') ? parseInt(urlParams.get('idx'), 10) : -1;
    var isEditMode = !isNaN(editIdx) && editIdx >= 0;

    $(document).ready(function() {
        if (!isEditMode) {
            initHeader();
        }

        $.when(
            $.getJSON('/Master/GetApiEmployees'),
            $.getJSON('/api-assets/currency.json'),
            $.getJSON('/api-assets/city.json'),
            $.getJSON('/api-assets/city_rate_matrix.json')
        ).done(function(empRes, curRes, cityRes, rateRes) {
            var empArr = (empRes && empRes[0]) ? empRes[0] : empRes;
            employeesData = Array.isArray(empArr) ? (Array.isArray(empArr[0]) ? empArr[0] : empArr) : [];
            currencyData = curRes[0] || curRes;
            if (Array.isArray(currencyData) && currencyData.length > 0 && Array.isArray(currencyData[0])) {
                currencyData = currencyData[0];
            }
            cityData = cityRes[0] || cityRes;
            if (Array.isArray(cityData) && cityData.length > 0 && Array.isArray(cityData[0])) {
                cityData = cityData[0];
            }
            rateMatrix = rateRes[0] || rateRes;
            if (Array.isArray(rateMatrix) && rateMatrix.length > 0 && Array.isArray(rateMatrix[0])) {
                rateMatrix = rateMatrix[0];
            }

            populateDropdowns();
            // Make all dropdowns searchable
            $('select.form-control').select2({ width: '100%' });

            if (isEditMode) {
                loadTripForEdit(editIdx);
            }
        }).fail(function() {
            alertify.log('Failed to load JSON data from /assets/', 'error', 5000);
        });

        $('#hdr-employee').change(onEmployeeChange);
        $('#hdr-currency').change(onCurrencyChange);
        $('.calc-trigger').on('change input', calculateDetails);


        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today",
            onChange: function() {
                calculateDetails();
            }
        });
    });

    function initHeader() {
        var d = new Date();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        var mmm = d.toLocaleString('default', { month: 'short' });
        
        var saved = JSON.parse(localStorage.getItem('savedBusinessTrips') || '[]');
        var seq = String(saved.length + 1).padStart(5, '0');
        $('#hdr-docno').val('BTR-' + mm + '-' + yy + '-' + seq);
    }

    // Loads an existing record (by its index in savedBusinessTrips) into the header + the full
    // staged trip-lines grid, switching the page into "update this record" mode.
    function loadTripForEdit(idx) {
        var existingData = JSON.parse(localStorage.getItem('savedBusinessTrips') || '[]');
        var item = existingData[idx];

        if (!item) {
            alertify.log('That Business Trip record could not be found.', 'error', 5000);
            window.location.href = '@Url.Action("BusinessTripIndex", "Master")';
            return;
        }

        $('.page-title-text').html('<i class="fas fa-plane fa-sm text-primary mr-2"></i> Edit Business Trip');
        $('#save-btn-label').text('Update');
        $('#hdr-docno').val(item.docNo || '');
        $('#hdr-date').val(item.date || '');
        $('#hdr-comments').val(item.comments || '');
        if (item.paymentType) $('#hdr-paymenttype').val(item.paymentType);

        stagedTrips = Array.isArray(item.items) ? item.items.slice() : [];

        var empId = item.employeeId;
        if (!empId && item.employeeName) {
            var matchEmp = employeesData.find(e => (e.name || e.sName) === item.employeeName);
            if (matchEmp) empId = matchEmp.id || matchEmp.iMasterId;
        }
        $('#hdr-employee').val(empId || '').trigger('change');

        var curId = item.currencyId;
        if (!curId && item.currency) {
            var matchCur = currencyData.find(c => c.code === item.currency);
            if (matchCur) curId = matchCur.id || matchCur.code;
        }
        $('#hdr-currency').val(curId || '').trigger('change');

        renderGrid();
    }

    function populateDropdowns() {
        var empSelect = $('#hdr-employee');
        empSelect.empty().append('<option value="">Select Employee...</option>');
        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.id || emp.iMasterId || '';
                var empCode = emp.code || emp.sCode || '';
                var empName = emp.name || emp.sName || '';
                empSelect.append(`<option value="${empId}">${empCode} - ${empName}</option>`);
            });
        }

        var curSelect = $('#hdr-currency');
        curSelect.empty().append('<option value="">Select Currency...</option>');
        if (Array.isArray(currencyData)) {
            currencyData.forEach(function(cur) {
                var curId = cur.id || cur.code || '';
                curSelect.append(`<option value="${curId}">${cur.code} - ${cur.name}</option>`);
            });
        }

        var fromCitySelect = $('#dtl-fromcity');
        var toCitySelect = $('#dtl-tocity');
        fromCitySelect.empty().append('<option value="">Select Departure City...</option>');
        toCitySelect.empty().append('<option value="">Select Arrival City...</option>');
        if (Array.isArray(cityData)) {
            cityData.forEach(function(city) {
                var cityId = city.id || city.code || '';
                var opt = `<option value="${cityId}">${city.code} - ${city.name}</option>`;
                fromCitySelect.append(opt);
                toCitySelect.append(opt);
            });
        }
    }

    function onEmployeeChange() {
        var empVal = $(this).val();
        if (!empVal) {
            $('#hdr-designation, #hdr-department, #hdr-manager').val('');
            return;
        }

        var emp = employeesData.find(e => e.id == empVal || e.iMasterId == empVal || e.code == empVal || e.sCode == empVal);
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || emp.reportingManagerName || emp.sReportingManager || '');
        }
    }
    
    function formatNumber(val) {
        if (val === "" || val === null || isNaN(val)) return "";
        return new Intl.NumberFormat(window.currentFormatLocale || 'en-US', {
            minimumFractionDigits: window.currentDecimals || 2,
            maximumFractionDigits: window.currentDecimals || 2
        }).format(val);
    }
    
    function parseNumber(val) {
        if (!val) return 0;
        return parseFloat(val.toString().replace(/,/g, '')) || 0;
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function onCurrencyChange() {
        var curId = parseInt($(this).val());
        if (!curId) {
            $('#hdr-exrate').val('');
            $('#sum-currency').text('');
            return;
        }
        var cur = currencyData.find(c => c.id === curId);
        if (cur) {
            $('#hdr-exrate').val(cur.exRate);
            $('#sum-currency').text(cur.code);
            window.currentDecimals = cur.numberofdecimal || 2;
            window.currentFormatLocale = cur.numberformat == "2" ? "en-IN" : "en-US";
            renderGrid();
        }
    }

    function calculateDetails() {
        var fromStr = $('#dtl-fromdate').val();
        var toStr = $('#dtl-todate').val();
        
        var duration = 0;
        if (fromStr && toStr) {
            var fp = fromStr.split('/');
            var tp = toStr.split('/');
            var f = new Date(fp[2], fp[1] - 1, fp[0]);
            var t = new Date(tp[2], tp[1] - 1, tp[0]);

            if (t >= f) {
                var diffTime = Math.abs(t - f);
                var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
                duration = diffDays + 1;
            } else {
                alertify.log('To Date cannot be earlier than From Date.', 'error', 5000);
                $('#dtl-todate').val('');
            }
        }
        $('#dtl-duration').val(duration);

        var fromCityId = parseInt($('#dtl-fromcity').val());
        var toCityId = parseInt($('#dtl-tocity').val());
        var rate = 0;

        if (fromCityId && toCityId) {
            var rateObj = rateMatrix.find(r => r.fromCityId === fromCityId && r.toCityId === toCityId);
            if (rateObj) {
                rate = rateObj.rate;
            } else {
                // Default rate if not in matrix
                rate = 100;
            }
        }
        $('#dtl-rate').val(formatNumber(rate));

        var amount = duration * rate;
        $('#dtl-amount').val(formatNumber(amount));
    }

    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();
        var totalAmount = 0;
        
        stagedTrips.forEach(function(item) {
            var tr = `<tr>
                <td class="action-btns" style="text-align:center;">
                    <a href="#" class="remove-item-btn" title="Delete" onclick="deleteStagedTrip('${item.stagedId}'); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                </td>
                <td>${item.fromDate} to ${item.toDate}</td>
                <td class="num-col">${item.duration}</td>
                <td>${item.fromCityName}</td>
                <td>${item.toCityName}</td>
                <td class="num-col">${formatNumber(item.rate)}</td>
                <td class="num-col">${formatNumber(item.amount)}</td>
                <td>${item.remarks || '-'}</td>
            </tr>`;
            uTbody.append(tr);
            totalAmount += item.amount;
        });
        
        $('#sum-amount').text(formatNumber(totalAmount));
    }

    function deleteStagedTrip(stagedId) {
        alertify.confirm('Are you sure you want to remove this trip?', function (e) {
            if (e) {
                stagedTrips = stagedTrips.filter(function(item) { return item.stagedId !== stagedId; });
                renderGrid();
            }
        });
    }

    function addToGrid() {
        var fromDate = $('#dtl-fromdate').val();
        var toDate = $('#dtl-todate').val();
        var duration = parseInt($('#dtl-duration').val()) || 0;
        var fromCityId = $('#dtl-fromcity').val();
        var toCityId = $('#dtl-tocity').val();
        var rate = parseNumber($('#dtl-rate').val()) || 0;
        var amount = parseNumber($('#dtl-amount').val()) || 0;
        
        if(!fromDate || !toDate || !fromCityId || !toCityId || duration <= 0) {
            alertify.log('Please select Dates and Cities properly.', 'error', 5000);
            return;
        }

        if(fromCityId === toCityId) {
            alertify.log('From City and To City cannot be the same.', 'error', 5000);
            return;
        }

        var fromCityName = $('#dtl-fromcity option:selected').text().split(' - ')[1];
        var toCityName = $('#dtl-tocity option:selected').text().split(' - ')[1];
        var remarks = $('#dtl-remarks').val();

        var uniqueStagedId = 'id_' + new Date().getTime();

        var newItem = {
            stagedId: uniqueStagedId,
            fromDate: fromDate,
            toDate: toDate,
            duration: duration,
            fromCityName: fromCityName,
            toCityName: toCityName,
            rate: rate,
            amount: amount,
            remarks: remarks
        };

        stagedTrips.push(newItem);
        renderGrid();
        
        // Reset inputs
        $('#dtl-fromdate').val('');
        $('#dtl-todate').val('');
        $('#dtl-duration').val('0');
        $('#dtl-fromcity').val('').trigger('change');
        $('#dtl-tocity').val('').trigger('change');
        $('#dtl-rate').val('0');
        $('#dtl-amount').val('0');
        $('#dtl-remarks').val('');
        
        calculateDetails();
    }

    function saveBusinessTrip() {
        if (stagedTrips.length === 0) {
            alertify.log('No trips added to the grid.', 'error', 5000);
            return;
        }

        if(!$('#hdr-employee').val() || !$('#hdr-currency').val()) {
            alertify.log('Please fill required Header fields.', 'error', 5000);
            return;
        }

        var existingTrips = JSON.parse(localStorage.getItem('savedBusinessTrips') || '[]');

        var newTrip = {
            docNo: $('#hdr-docno').val(),
            date: $('#hdr-date').val(),
            employeeId: $('#hdr-employee').val(),
            employeeName: $('#hdr-employee option:selected').text().split(' - ')[1] || $('#hdr-employee option:selected').text(),
            currencyId: $('#hdr-currency').val(),
            currency: $('#sum-currency').text(),
            paymentType: $('#hdr-paymenttype').val(),
            comments: $('#hdr-comments').val() || '',
            totalAmount: $('#sum-amount').text(),
            items: stagedTrips,
            // Preserve the record's existing status when editing — the create flow has no status
            // control of its own, so defaulting to 'Pending' here would silently undo any status
            // progression (e.g. Approved) set elsewhere.
            status: (isEditMode && existingTrips[editIdx]) ? existingTrips[editIdx].status : 'Pending'
        };

        if (isEditMode) {
            existingTrips[editIdx] = newTrip;
        } else {
            existingTrips.push(newTrip);
        }
        localStorage.setItem('savedBusinessTrips', JSON.stringify(existingTrips));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: isEditMode ? 'Business Trip updated successfully!' : 'Business Trip saved successfully!', type: 'success' }));
        var targetUrl = '@Url.Action("BusinessTripIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }
</script>

