@{
    ViewData["Title"] = "Opening Leaves";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-calendar-plus fa-sm text-primary mr-2"></i> Opening Leaves
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("OpeningLeavesIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" onclick="saveRecord()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> <span id="save-btn-label">Save</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="entryForm" autocomplete="off">
        <!-- COMMON HEADER CARD -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted">Upload supporting attachment if any.</small>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Comments / Reason</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter comments or notes..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- INLINE EDITABLE GRID CARD -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex align-items-center justify-content-between">
            <span><i class="fas fa-list mr-2"></i>Opening Leaves Detailed</span>
            <button type="button" class="btn btn-light btn-sm font-weight-bold text-primary shadow-sm" onclick="addRow()">
                <i class="fas fa-plus fa-sm mr-1"></i> Add Row
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 60px; text-align:center;">Action</th>
                            <th style="min-width: 220px;">Employee <span class="text-danger">*</span></th>
                            <th style="min-width: 200px;">Leave Type <span class="text-danger">*</span></th>
                            <th style="width: 140px;" class="text-right">Duration (Days) <span class="text-danger">*</span></th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var employeesData = [];
    var leaveTypesData = [];

    // Edit mode: ?idx=<array index into savedOpeningLeaves> means "edit this existing record" instead
    // of creating a new one — navigated to directly from OpeningLeavesIndex's Edit link (a plain page
    // link now, no modal) exactly like CreateLeaveApplication's own ?id= pattern.
    var urlParams = new URLSearchParams(window.location.search);
    var editIdx = urlParams.has('idx') ? parseInt(urlParams.get('idx'), 10) : -1;
    var isEditMode = !isNaN(editIdx) && editIdx >= 0;

    $(document).ready(function() {
        if (!isEditMode) {
            initHeader();
        }

        $.when(
            $.getJSON('/Master/GetApiEmployees'),
            $.getJSON('/Master/GetApiLeaveTypes')
        ).done(function(empRes, leaveRes) {
            var empArr = (empRes && empRes[0]) ? empRes[0] : empRes;
            employeesData = Array.isArray(empArr) ? (Array.isArray(empArr[0]) ? empArr[0] : empArr) : [];
            var leaveData = (leaveRes && leaveRes[0]) ? leaveRes[0] : leaveRes;
            leaveTypesData = leaveData.leaveTypes || (Array.isArray(leaveData) ? leaveData : []);

            if (isEditMode) {
                loadRecordForEdit(editIdx);
            } else {
                // Automatically add initial clean row
                addRow();
            }
        }).fail(function() {
            alertify.log('Failed to load Opening Leaves data.', 'error', 5000);
        });

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });
    });

    // Loads an existing record (by its index in savedOpeningLeaves) into the header + a single pre-filled
    // grid row, switching the page into "update this record" mode. Mirrors the one-record-at-a-time
    // granularity the old Edit modal had — "Add Row" is hidden in edit mode for the same reason.
    function loadRecordForEdit(idx) {
        var existingData = JSON.parse(localStorage.getItem('savedOpeningLeaves') || '[]');
        var item = existingData[idx];

        if (!item) {
            alertify.log('That Opening Leaves record could not be found.', 'error', 5000);
            window.location.href = '@Url.Action("OpeningLeavesIndex", "Master")';
            return;
        }

        $('.page-title-text').html('<i class="fas fa-calendar-plus fa-sm text-primary mr-2"></i> Edit Opening Leaves');
        $('#save-btn-label').text('Update');
        $('#hdr-docno').val(item.docNo || '');
        $('#hdr-date').val(item.date || '');
        $('#hdr-comments').val(item.comments || '');
        $('[onclick="addRow()"]').hide();

        addRow();
        var $row = $('#user-grid-table tbody tr').first();
        $row.find('.remove-item-btn').hide();
        $row.find('.grid-employee').val(item.employeeId || '').trigger('change');
        $row.find('.grid-leavetype').val(item.leaveTypeId || '').trigger('change');
        $row.find('.grid-duration').val(item.duration || '');
        $row.find('.grid-remarks').val(item.remarks || '');
    }

    function initHeader() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        var randId = Math.floor(Math.random() * 90000) + 10000;
        
        $('#hdr-date').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-postdate').val(dd + '-' + mmm + '-' + yyyy);
        $('#hdr-docno').val('OL-' + mm + '-' + yy + '-' + randId);
    }

    function addRow() {
        var tbody = $('#user-grid-table tbody');
        
        var empOptions = '<option value="">Select Employee...</option>';
        if (Array.isArray(employeesData)) {
            employeesData.forEach(function(emp) {
                var empId = emp.id || emp.iMasterId || '';
                var empCode = emp.code || emp.sCode || '';
                var empName = emp.name || emp.sName || '';
                empOptions += `<option value="${empId}">${empCode} - ${empName}</option>`;
            });
        }

        var leaveOptions = '<option value="">Select Leave Type...</option>';
        if (Array.isArray(leaveTypesData)) {
            leaveTypesData.forEach(function(lt) {
                var ltId = lt.id || lt.code || '';
                var ltCode = lt.code || '';
                var ltName = lt.name || '';
                leaveOptions += `<option value="${ltId}">${ltCode} - ${ltName}</option>`;
            });
        }

        var rowId = 'row_' + new Date().getTime() + '_' + Math.floor(Math.random()*1000);

        var trHtml = `<tr id="${rowId}">
            <td class="action-btns" style="text-align:center;">
                <a href="#" class="remove-item-btn" title="Delete Row" onclick="deleteRow('${rowId}'); return false;"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
            </td>
            <td>
                <select class="form-control form-control-sm grid-employee">${empOptions}</select>
            </td>
            <td>
                <select class="form-control form-control-sm grid-leavetype">${leaveOptions}</select>
            </td>
            <td>
                <input type="number" step="0.5" class="form-control form-control-sm text-right grid-duration" placeholder="0.0" />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm grid-remarks" placeholder="Enter remarks..." />
            </td>
        </tr>`;

        tbody.append(trHtml);
        $('#' + rowId + ' select').select2({ width: '100%' });
    }

    function deleteRow(rowId) {
        if ($('#user-grid-table tbody tr').length <= 1) {
            alertify.log('At least one row must remain in the grid.', 'error', 5000);
            return;
        }
        $('#' + rowId).remove();
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 5000);
                input.value = '';
            }
        }
    }

    function saveRecord() {
        var rows = $('#user-grid-table tbody tr');
        if (rows.length === 0) {
            alertify.log('No items added to the grid.', 'error', 5000);
            return;
        }

        var docNo = $('#hdr-docno').val();
        var date = $('#hdr-date').val();
        var comments = $('#hdr-comments').val();

        var newRecords = [];
        var isValid = true;
        var existingData = JSON.parse(localStorage.getItem('savedOpeningLeaves') || '[]');

        rows.each(function() {
            var empId = $(this).find('.grid-employee').val();
            var leaveTypeId = $(this).find('.grid-leavetype').val();
            var duration = $(this).find('.grid-duration').val();
            var remarks = $(this).find('.grid-remarks').val();

            if (!empId || !leaveTypeId || !duration || parseFloat(duration) <= 0) {
                isValid = false;
                return false;
            }

            var empObj = employeesData.find(e => e.id == empId || e.iMasterId == empId || e.code == empId || e.sCode == empId);
            var leaveObj = leaveTypesData.find(l => l.id == leaveTypeId || l.code == leaveTypeId);

            var empName = empObj ? (empObj.code + ' - ' + empObj.name) : 'Employee';
            var leaveTypeName = leaveObj ? (leaveObj.code + ' - ' + leaveObj.name) : 'Leave';

            newRecords.push({
                docNo: docNo,
                date: date,
                comments: comments,
                employeeId: empId,
                employeeName: empName,
                leaveTypeId: leaveTypeId,
                leaveTypeName: leaveTypeName,
                duration: duration,
                remarks: remarks,
                // Preserve the record's existing status when editing (the create flow has no status
                // control of its own — only the old Edit modal did — so defaulting to 'Active' here would
                // silently undo an "Inactive" status set earlier).
                status: (isEditMode && existingData[editIdx]) ? existingData[editIdx].status : 'Active'
            });
        });

        if (!isValid) {
            alertify.log('Please select Employee, Leave Type and enter a valid Duration in all grid rows.', 'error', 5000);
            return;
        }

        if (isEditMode) {
            existingData[editIdx] = newRecords[0];
        } else {
            existingData = existingData.concat(newRecords);
        }
        localStorage.setItem('savedOpeningLeaves', JSON.stringify(existingData));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ msg: isEditMode ? 'Opening Leaves updated successfully!' : 'Opening Leaves saved successfully!', type: 'success' }));
        var targetUrl = '@Url.Action("OpeningLeavesIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }
</script>
