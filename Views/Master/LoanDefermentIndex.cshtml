@{
    ViewData["Title"] = "Loan Deferments";
}

<!-- DataTables & Alertify -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #deferment-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #deferment-grid tbody tr:hover { background-color: #f0f3ff; }
    #deferment-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit      { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }

    .badge-warning { background-color: #f6c23e; color: #222; }
    .num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-calendar-minus fa-sm"></i>
                    Loan Deferments List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("CreateLoanDeferment", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create Deferment
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Deferments</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-history fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Active Loan Deferments</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Deferred Balance</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-balance">$ --</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-hand-holding-usd fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATATABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="deferment-grid" width="100%">
                    <thead>
                        <tr>
                            <th style="width: 70px; text-align:center;">Action</th>
                            <th>Deferment No</th>
                            <th>Date</th>
                            <th>Disbursement No</th>
                            <th>Employee</th>
                            <th>Loan Type</th>
                            <th class="num-col">Original Amount</th>
                            <th class="num-col">Modified Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<script>
    var defermentTable = null;
    var createDefermentUrl = '@Url.Action("CreateLoanDeferment", "Master")';

    // Seed savedLoanDeferments with the original two demo rows exactly once, then only ever
    // read/write localStorage from here on, matching the pattern used by every other prototype module.
    function seedDefermentsIfNeeded() {
        if (localStorage.getItem('savedLoanDeferments')) return;
        var demoRows = [
            {
                defermentNo: 'DEF-07-26-00001',
                date: '26-Jul-2026',
                disbursementNo: 'DSB-07-26-00001',
                employeeCode: 'EMP-001',
                employeeName: 'John Smith',
                loanTypeName: 'Personal Loan',
                originalAmount: 106500,
                modifiedAmount: 106500,
                status: 'Active Deferment'
            },
            {
                defermentNo: 'DEF-07-26-00002',
                date: '27-Jul-2026',
                disbursementNo: 'DSB-07-26-00002',
                employeeCode: 'EMP-002',
                employeeName: 'Sarah Connor',
                loanTypeName: 'Emergency Loan',
                originalAmount: 243500,
                modifiedAmount: 243500,
                status: 'Active Deferment'
            }
        ];
        localStorage.setItem('savedLoanDeferments', JSON.stringify(demoRows));
    }

    function loadGridData() {
        var data = JSON.parse(localStorage.getItem('savedLoanDeferments') || '[]');
        defermentTable.clear();

        var totalBalance = 0;
        var activeCount = 0;

        data.forEach(function(item) {
            var originalAmount = parseFloat(item.originalAmount) || 0;
            var modifiedAmount = parseFloat(item.modifiedAmount) || 0;
            totalBalance += modifiedAmount;
            if (item.status === 'Active Deferment') activeCount++;

            var actionHtml = '<div class="action-btns" style="text-align:center;">' +
                '<a href="' + createDefermentUrl + '?docNo=' + encodeURIComponent(item.defermentNo || '') + '" title="Edit"><i class="fas fa-edit"></i></a> ' +
                '<a href="#" class="remove-item-btn" data-docno="' + (item.defermentNo || '') + '" title="Delete"><i class="fas fa-trash-alt"></i></a>' +
                '</div>';

            defermentTable.row.add([
                actionHtml,
                '<strong>' + (item.defermentNo || '-') + '</strong>',
                item.date || '-',
                item.disbursementNo || '-',
                (item.employeeCode || '') + ' - ' + (item.employeeName || ''),
                item.loanTypeName || '-',
                originalAmount.toLocaleString('en-US', {minimumFractionDigits: 2}),
                modifiedAmount.toLocaleString('en-US', {minimumFractionDigits: 2}),
                '<span class="badge badge-warning">' + (item.status || 'Active Deferment') + '</span>'
            ]);
        });

        $('#stat-total').text(data.length);
        $('#stat-active').text(activeCount);
        $('#stat-balance').text('$' + totalBalance.toLocaleString('en-US', {minimumFractionDigits: 2}));

        defermentTable.draw(false);
    }

    $(document).ready(function() {
        defermentTable = $('#deferment-grid').DataTable({
            pageLength: 10,
            order: [[1, 'desc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search deferments..."
            },
            columnDefs: [
                { orderable: false, targets: 0 }
            ]
        });

        seedDefermentsIfNeeded();
        loadGridData();

        $('#deferment-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');

            alertify.confirm('Are you sure you want to delete deferment: ' + docNo + '?', function (confirmed) {
                if (confirmed) {
                    var data = JSON.parse(localStorage.getItem('savedLoanDeferments') || '[]');
                    data = data.filter(function(r) { return r.defermentNo !== docNo; });
                    localStorage.setItem('savedLoanDeferments', JSON.stringify(data));
                    loadGridData();
                    alertify.log('Deferment ' + docNo + ' deleted successfully.', 'success', 3500);
                }
            });
        });
    });
</script>
