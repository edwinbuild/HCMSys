@{
    ViewData["Title"] = "HR Request";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    html { font-size: 14px; }
    .select2-container .select2-selection--single {
        height: calc(1.5em + .75rem + 2px);
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: calc(1.5em + .75rem);
        color: #6e707e;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: calc(1.5em + .75rem);
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; cursor: pointer; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-trash-alt { color: #e74a3b; }
    .action-btns .fa-edit { color: #4e73df; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .form-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
    }
    .form-control { font-size: 0.85rem; border-color: #d1d3e2; color: #6e707e; border-radius: 0.35rem; }
    .form-control:focus { border-color: #bac8f3; box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2); }
    
    .card-header-custom {
        background-color: #4e73df;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 15px;
    }
    .number-align {
        text-align: right;
    }
    input[type="text"], textarea, select { text-align: left; }
    .form-control[readonly]:not(.flatpickr-input):not(.datepicker) { 
        background-color: #e9ecef !important; 
        opacity: 1; 
    }
    .flatpickr-input[readonly], .datepicker[readonly] {
        background-color: #ffffff !important;
        opacity: 1 !important;
    }
    .table th, .table td { vertical-align: middle; }
    .table td.num-col { text-align: right; }

    .reqtype-badge {
        display: inline-block;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .reqtype-documents {
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
    }
    .reqtype-returnable {
        background-color: #fef8e7;
        color: #b78103;
        border: 1px solid #ffeeba;
    }
    .reqtype-issueonly {
        background-color: #e6f9f0;
        color: #0d8a4f;
        border: 1px solid #c3e6cb;
    }

    .row-selected-edit {
        background-color: #fff3cd !important;
        border-left: 4px solid #ffc107;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text" id="page-header-title">
                    <i class="fas fa-hand-holding fa-sm text-primary mr-2"></i> HR Request
                </div>
                <div class="ml-auto mt-2 mt-sm-0">
                    <a href="@Url.Action("HRRequestIndex", "Master")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Back to List
                    </a>
                    <button type="button" class="btn btn-success btn-sm shadow-sm ml-2" id="btn-save-request" onclick="saveRequest()">
                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save Request
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form id="requestForm" autocomplete="off">
        <input type="hidden" id="hdr-edit-id" value="0" />

        <!-- COMMON HEADER CARD (API-DRIVEN EMPLOYEES) -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom">
                <i class="fas fa-info-circle mr-2"></i>General Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Doc No</label>
                        <input type="text" class="form-control font-weight-bold text-primary" id="hdr-docno" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-date" readonly />
                    </div>
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Post Date</label>
                        <input type="text" class="form-control datepicker" id="hdr-postdate" readonly />
                    </div>
                    
                    <!-- Employee dropdown: Loaded via Live API -->
                    <div class="col-6 col-md-3 mb-3">
                        <label class="form-label">Employee <span class="text-danger">*</span></label>
                        <select class="form-control" id="hdr-employee" required>
                            <option value="">Loading Employees...</option>
                        </select>
                    </div>

                    <!-- Auto-populated from Live API Employee Profile -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Designation</label>
                        <input type="text" class="form-control" id="hdr-designation" readonly placeholder="Auto loaded from API" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Department</label>
                        <input type="text" class="form-control" id="hdr-department" readonly placeholder="Auto loaded from API" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Reporting Manager</label>
                        <input type="text" class="form-control" id="hdr-manager" readonly placeholder="Auto loaded from API" />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">Comments / Reason</label>
                        <textarea class="form-control" id="hdr-comments" rows="2" maxlength="250" placeholder="Enter reason or comments..." onkeyup="document.getElementById('comments-counter').innerText = this.value.length + '/250'"></textarea>
                        <div id="comments-counter" class="text-right small text-muted mt-1">0/250</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Attachment (Max 25MB)</label>
                        <input type="file" class="form-control p-1" id="hdr-attachment" accept="image/*,.pdf,text/plain,.doc,.docx,.xls,.xlsx" onchange="checkFileSize(this)" />
                        <small class="text-muted">Upload request proof if any.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- REQUEST DETAILS CARD (JSON-DRIVEN REQUEST CATALOG) -->
        <div class="card shadow mb-4">
            <div class="card-header card-header-custom bg-info">
                <i class="fas fa-file-alt mr-2"></i>Request Details
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Request Selection: Loaded via JSON catalog -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Selection / Item <span class="text-danger">*</span></label>
                        <select class="form-control" id="dtl-selection" required>
                            <option value="">Select Request Item...</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Request Type</label>
                        <input type="text" class="form-control font-weight-bold text-dark" id="dtl-requesttype" readonly placeholder="Auto from JSON master" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" class="form-control" id="dtl-remarks" placeholder="Optional line remarks..." />
                    </div>

                    <!-- Quantity: Preload with 1 and hide as specified -->
                    <input type="hidden" id="dtl-qty" value="1" />
                    <input type="hidden" id="dtl-prefix" value="" />
                    
                    <div class="col-md-12 text-right mt-2" id="grid-btn-container">
                        <button type="button" class="btn btn-secondary btn-sm shadow-sm mr-2" id="btn-cancel-edit" style="display:none;" onclick="cancelLineEdit()">
                            <i class="fas fa-times fa-sm text-white-50 mr-1"></i> Cancel Edit
                        </button>
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btn-add-grid" onclick="addToGrid()">
                            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add to Grid
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- REQUESTS DETAILED GRID -->
    <div class="card shadow mb-4">
        <div class="card-header card-header-custom bg-secondary d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Requests Detailed</span>
            <small class="text-white-50">Staged items for this HR request document</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="user-grid-table">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 75px; text-align:center;">Action</th>
                            <th>Selection / Item</th>
                            <th>Request Type</th>
                            <th class="num-col" style="width: 90px;">Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="empty-row"><td colspan="5" class="text-center text-muted py-3">No requests added to the grid yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    var employeesData = [];
    var requestMasterData = [];
    var stagedRequests = [];
    var editHeaderId = 0;
    var editDocNo = '';
    var isEditMode = false;
    var editingStagedId = null;

    $(document).ready(function() {
        var urlParams = new URLSearchParams(window.location.search);
        var paramDocNo = urlParams.get('docNo') || '';
        var paramId = urlParams.get('id') || '@ViewBag.EditId';
        editDocNo = paramDocNo;
        editHeaderId = parseInt(paramId) || 0;
        isEditMode = (editDocNo.length > 0 || editHeaderId > 0);

        if (isEditMode) {
            $('#page-header-title').html('<i class="fas fa-edit fa-sm text-primary mr-2"></i> Edit HR Request <span class="badge badge-primary font-weight-bold ml-2">Edit Mode</span>');
            $('#btn-save-request').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Request');
            $('#hdr-edit-id').val(editHeaderId);
        }

        initHeaderDocNo();

        flatpickr(".datepicker", {
            dateFormat: "d-M-Y",
            defaultDate: "today"
        });

        // 1. LIVE API: Load Employees from live API endpoint
        // 2. JSON: Load Request Master catalog from /api-assets/request_master.json
        function loadMasters() {
            var empPromise = $.getJSON('/Master/GetApiEmployees').then(function(res) {
                var empList = Array.isArray(res) ? (Array.isArray(res[0]) ? res[0] : res) : (res && res.data ? res.data : []);
                return empList;
            }, function() {
                if (typeof alertify !== 'undefined') {
                    alertify.log('Failed to fetch employee list from API.', 'error', 4000);
                }
                return [];
            });

            var reqPromise = $.getJSON('/api-assets/request_master.json').then(function(res) {
                return Array.isArray(res) ? res : [];
            }, function() {
                return $.getJSON('/Master/GetApiRequestMaster');
            });

            $.when(empPromise, reqPromise).done(function(empRes, reqRes) {
                var rawEmp = (empRes && empRes[0]) ? empRes[0] : empRes;
                employeesData = Array.isArray(rawEmp) ? rawEmp : (Array.isArray(empRes) ? empRes : []);
                var rawReq = (reqRes && reqRes[0]) ? reqRes[0] : reqRes;
                requestMasterData = Array.isArray(rawReq) ? rawReq : (Array.isArray(reqRes) ? reqRes : []);

                populateDropdowns();

                if (isEditMode) {
                    loadRequestForEdit(editHeaderId, editDocNo);
                }
            });
        }

        loadMasters();

        $('#hdr-employee').change(onEmployeeChange);
        $('#dtl-selection').change(onSelectionChange);
    });

    function initHeaderDocNo() {
        if (isEditMode) return;

        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var mmm = months[d.getMonth()];
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);
        var yyyy = d.getFullYear();
        var todayStr = dd + '-' + mmm + '-' + yyyy;

        $('#hdr-date').val(todayStr);
        $('#hdr-postdate').val(todayStr);
        
        var saved = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
        var maxNum = 0;
        saved.forEach(function(item) {
            var dNo = item.docNo || item.reqNo || '';
            var match = dNo.match(/\d+$/);
            if (match) {
                var n = parseInt(match[0], 10);
                if (!isNaN(n) && n > maxNum) maxNum = n;
            }
        });
        var nextSeq = Math.max(maxNum, saved.length) + 1;
        $('#hdr-docno').val('HRR-' + mm + '-' + yy + '-' + String(nextSeq).padStart(5, '0'));
    }

    function populateDropdowns() {
        // 1. Employee dropdown (Live API)
        var empSelect = $('#hdr-employee');
        empSelect.empty().append('<option value="">Select Employee...</option>');
        if (Array.isArray(employeesData) && employeesData.length > 0) {
            employeesData.forEach(function(emp) {
                var empId = emp.iMasterId || emp.id || '';
                var empCode = emp.sCode || emp.code || '';
                var empName = emp.sName || emp.name || '';
                empSelect.append(`<option value="${empId}" data-code="${empCode}" data-name="${empName}">${empCode} - ${empName}</option>`);
            });
        }
        empSelect.select2({ width: '100%' });

        // 2. Request Master dropdown (JSON catalog)
        var reqSelect = $('#dtl-selection');
        reqSelect.empty().append('<option value="">Select Request Item...</option>');
        if (Array.isArray(requestMasterData) && requestMasterData.length > 0) {
            requestMasterData.forEach(function(req) {
                var rCode = req.code || ('REQ-' + req.id);
                var rName = req.name || '';
                var rType = req.type || 'Documents';
                var rPrefix = req.prefix || '';
                reqSelect.append(`<option value="${rCode}" data-name="${rName}" data-type="${rType}" data-prefix="${rPrefix}">${rName} (${rType})</option>`);
            });
        }
        reqSelect.select2({ width: '100%' });
    }

    // Triggered on Employee selection (Live API data binding)
    function onEmployeeChange() {
        var empVal = $('#hdr-employee').val();
        if (!empVal) {
            $('#hdr-designation, #hdr-department, #hdr-manager').val('');
            return;
        }

        var emp = employeesData.find(e => String(e.id) === String(empVal) || String(e.iMasterId) === String(empVal) || String(e.code) === String(empVal) || String(e.sCode) === String(empVal));
        if (emp) {
            $('#hdr-designation').val(emp.designation || emp.designationName || emp.sDesignationName || '-');
            $('#hdr-department').val(emp.department || emp.departmentName || emp.sDepartmentName || '-');
            $('#hdr-manager').val(emp.sReportingToName || emp.reportingToName || emp.reportingManager || emp.manager || '-');
        }
    }
    
    // Triggered on Request Item selection (JSON catalog data binding)
    function onSelectionChange() {
        var opt = $('#dtl-selection option:selected');
        var reqType = opt.data('type') || '';
        var prefix = opt.data('prefix') || '';

        $('#dtl-requesttype').val(reqType);
        $('#dtl-prefix').val(prefix);
    }

    function checkFileSize(input) {
        if (input.files && input.files[0]) {
            if (input.files[0].size > 25 * 1024 * 1024) {
                alertify.log('File size exceeds 25MB limit.', 'error', 4000);
                input.value = '';
            }
        }
    }

    function addToGrid() {
        var selectionCode = $('#dtl-selection').val();
        if (!selectionCode) {
            alertify.log('Please select a Request Item.', 'error', 4000);
            $('#dtl-selection').select2('open');
            return;
        }

        var opt = $('#dtl-selection option:selected');
        var selectionName = opt.data('name') || opt.text();
        var requestType = $('#dtl-requesttype').val() || opt.data('type') || 'Documents';
        var prefix = $('#dtl-prefix').val() || opt.data('prefix') || '';
        var remarks = $('#dtl-remarks').val() || '';
        var qty = parseInt($('#dtl-qty').val()) || 1;

        if (qty <= 0) {
            alertify.log('Quantity must be at least 1.', 'error', 3500);
            $('#dtl-qty').focus();
            return;
        }

        // Duplicate Check in the current grid
        var isDuplicate = stagedRequests.some(function(item) {
            if (editingStagedId && item.stagedId === editingStagedId) return false;
            return item.selectionCode === selectionCode;
        });

        if (isDuplicate) {
            alertify.log(`Request item "${selectionName}" is already added in the table. Duplicate items cannot be added multiple times in the same request.`, 'error', 5000);
            return;
        }

        // Carry the line's originalStatus through an in-grid edit too, so tweaking a pre-loaded
        // row (qty/remarks) before the final save doesn't also reset its status to Pending.
        var existingStaged = editingStagedId ? stagedRequests.find(i => i.stagedId === editingStagedId) : null;

        var item = {
            stagedId: editingStagedId || ('STG_' + Date.now()),
            selectionCode: selectionCode,
            selectionName: selectionName,
            requestType: requestType,
            prefix: prefix,
            qty: qty,
            remarks: remarks,
            originalStatus: existingStaged ? existingStaged.originalStatus : undefined
        };

        if (editingStagedId) {
            var idx = stagedRequests.findIndex(i => i.stagedId === editingStagedId);
            if (idx > -1) stagedRequests[idx] = item;
            editingStagedId = null;
            $('#btn-cancel-edit').hide();
            $('#btn-add-grid').html('<i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add to Grid');
        } else {
            stagedRequests.push(item);
        }

        renderGrid();
        
        // Reset line inputs
        $('#dtl-selection').val('').trigger('change');
        $('#dtl-requesttype').val('');
        $('#dtl-remarks').val('');
        $('#dtl-qty').val('1');
        alertify.log('Request line added successfully.', 'success', 2500);
    }

    function renderGrid() {
        var uTbody = $('#user-grid-table tbody');
        uTbody.empty();

        if (stagedRequests.length === 0) {
            uTbody.append('<tr id="empty-row"><td colspan="5" class="text-center text-muted py-3">No requests added to the grid yet.</td></tr>');
            return;
        }
        
        stagedRequests.forEach(function(item) {
            var badgeClass = 'reqtype-documents';
            if (item.requestType === 'Returnable') badgeClass = 'reqtype-returnable';
            if (item.requestType === 'Issueonly') badgeClass = 'reqtype-issueonly';

            var tr = `<tr id="row-${item.stagedId}">
                <td class="action-btns" style="text-align:center;">
                    <a onclick="editStagedRequest('${item.stagedId}')" title="Edit line"><i class="fas fa-edit"></i></a>
                    <a onclick="deleteStagedRequest('${item.stagedId}')" title="Delete line"><i class="fas fa-trash-alt"></i></a>
                </td>
                <td class="font-weight-bold text-dark">${item.selectionName || '-'}</td>
                <td><span class="reqtype-badge ${badgeClass}">${item.requestType || '-'}</span></td>
                <td class="num-col font-weight-bold text-primary">${item.qty}</td>
                <td>${item.remarks || '-'}</td>
            </tr>`;
            uTbody.append(tr);
        });
    }

    function editStagedRequest(stagedId) {
        var item = stagedRequests.find(i => i.stagedId === stagedId);
        if (!item) return;

        editingStagedId = stagedId;
        $('#dtl-selection').val(item.selectionCode).trigger('change');
        $('#dtl-qty').val(item.qty || 1);
        $('#dtl-remarks').val(item.remarks || '');

        $('#btn-cancel-edit').show();
        $('#btn-add-grid').html('<i class="fas fa-save fa-sm text-white-50 mr-1"></i> Update Line');
        $('#user-grid-table tbody tr').removeClass('row-selected-edit');
        $('#row-' + stagedId).addClass('row-selected-edit');
    }

    function cancelLineEdit() {
        editingStagedId = null;
        $('#btn-cancel-edit').hide();
        $('#btn-add-grid').html('<i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Add to Grid');
        $('#user-grid-table tbody tr').removeClass('row-selected-edit');
        $('#dtl-selection').val('').trigger('change');
        $('#dtl-remarks').val('');
        $('#dtl-qty').val('1');
    }

    function deleteStagedRequest(stagedId) {
        stagedRequests = stagedRequests.filter(item => item.stagedId !== stagedId);
        if (editingStagedId === stagedId) cancelLineEdit();
        renderGrid();
        alertify.log('Request line removed.', 'success', 2000);
    }

    function saveRequest() {
        var empId = $('#hdr-employee').val();
        if (!empId) {
            alertify.log('Please select an Employee before saving.', 'error', 4000);
            $('#hdr-employee').select2('open');
            return;
        }

        if (stagedRequests.length === 0) {
            alertify.log('Please add at least one request item to the grid before saving.', 'error', 4500);
            $('#dtl-selection').select2('open');
            return;
        }

        var d = new Date();
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var yy = String(d.getFullYear()).slice(-2);

        var empOpt = $('#hdr-employee option:selected');
        var empCode = empOpt.data('code') || '';
        var empName = empOpt.data('name') || empOpt.text();
        var docNo = $('#hdr-docno').val();
        var docDate = $('#hdr-date').val();
        var postDate = $('#hdr-postdate').val();
        var comments = $('#hdr-comments').val() || '';

        var fileInput = document.getElementById('hdr-attachment');
        var attachFileName = (fileInput && fileInput.files.length > 0) ? fileInput.files[0].name : '';

        var savedRequests = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');

        if (isEditMode) {
            // Remove previous items belonging to this document and replace with updated ones
            savedRequests = savedRequests.filter(r => 
                (!editDocNo || r.docNo !== editDocNo) && 
                (!editHeaderId || (r.id !== editHeaderId && String(r.id) !== String(editHeaderId)))
            );
        }

        stagedRequests.forEach(function(sr, idx) {
            var reqNo = (sr.prefix ? sr.prefix + '-' : 'REQ-') + mm + '-' + yy + '-' + Math.floor(1000 + Math.random() * 9000);
            
            var newRecord = {
                id: (isEditMode && editHeaderId) ? editHeaderId : Date.now() + idx,
                docNo: docNo,
                date: docDate,
                postDate: postDate,
                employeeId: empId,
                employeeCode: empCode,
                employeeName: empName,
                department: $('#hdr-department').val(),
                designation: $('#hdr-designation').val(),
                manager: $('#hdr-manager').val(),
                comments: comments,
                reqNo: reqNo,
                selectionCode: sr.selectionCode,
                selectionName: sr.selectionName,
                requestType: sr.requestType,
                prefix: sr.prefix,
                qty: sr.qty,
                remarks: sr.remarks,
                // Preserve the line's existing status when editing; only brand-new rows (added during
                // this edit, with no prior saved status) start as Pending.
                status: sr.originalStatus || 'Pending',
                attachmentName: attachFileName
            };

            savedRequests.push(newRecord);
        });

        localStorage.setItem('savedHRRequests', JSON.stringify(savedRequests));

        sessionStorage.setItem('pendingAlert', JSON.stringify({ 
            msg: `HR Request ${docNo} for ${empName} saved successfully!`, 
            type: 'success' 
        }));

        var targetUrl = '@Url.Action("HRRequestIndex", "Master")';
        if (typeof loadPageContent === 'function') {
            loadPageContent(targetUrl, true);
        } else {
            window.location.href = targetUrl;
        }
    }

    function loadRequestForEdit(id, docNo) {
        var saved = JSON.parse(localStorage.getItem('savedHRRequests') || '[]');
        var records = saved.filter(r => (docNo && r.docNo === docNo) || (id && (r.id === id || String(r.id) === String(id))));
        if (records.length > 0) {
            applyLoadedRecords(records);
        } else {
            $.getJSON('/api-assets/hr_requests.json').done(function(seedData) {
                if (Array.isArray(seedData)) {
                    var seedRecords = seedData.filter(r => (docNo && r.docNo === docNo) || (id && (r.id === id || String(r.id) === String(id))));
                    if (seedRecords.length > 0) {
                        applyLoadedRecords(seedRecords);
                    }
                }
            });
        }
    }

    function applyLoadedRecords(records) {
        var first = records[0];
        editDocNo = first.docNo || '';
        editHeaderId = first.id || 0;
        $('#hdr-edit-id').val(editHeaderId);
        $('#hdr-docno').val(first.docNo || '');
        $('#hdr-date').val(first.date || '');
        $('#hdr-postdate').val(first.postDate || first.date || '');
        $('#hdr-comments').val(first.comments || '');
        if (first.comments) $('#comments-counter').text(first.comments.length + '/250');

        if (first.employeeId) {
            $('#hdr-employee').val(String(first.employeeId)).trigger('change');
        }

        stagedRequests = records.map(function(r, idx) {
            return {
                stagedId: 'STG_EDIT_' + idx + '_' + Date.now(),
                selectionCode: r.selectionCode,
                selectionName: r.selectionName,
                requestType: r.requestType,
                prefix: r.prefix,
                qty: r.qty || 1,
                remarks: r.remarks || '',
                // Carried through to saveRequest() so updating an existing request doesn't silently
                // reset its status (e.g. Issued/Approved) back to Pending.
                originalStatus: r.status || 'Pending'
            };
        });

        renderGrid();
    }
</script>
