@{
    ViewData["Title"] = "Loan Disbursements";
}

<!-- DataTables & Alertify -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }
    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #disbursements-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #disbursements-grid tbody tr:hover { background-color: #f0f3ff; }
    #disbursements-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit      { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }
    .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }

    .badge-success { background-color: #1cc88a; color: white; }
    .num-col { text-align: right; }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-file-invoice-dollar fa-sm"></i>
                    Loan Disbursements List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("CreateLoanDisbursement", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create Disbursement
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Disbursements</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-double fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Sanctioned</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-sanctioned">$ --</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-check-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Avg Interest Rate</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-interest">-- %</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-percentage fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Active Loans</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tasks fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATATABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0" id="disbursements-grid" width="100%">
                    <thead>
                        <tr>
                            <th style="width: 70px; text-align:center;">Action</th>
                            <th>Disbursement No</th>
                            <th>Disb Date</th>
                            <th>Request No</th>
                            <th>Employee</th>
                            <th>Loan Type</th>
                            <th class="num-col">Sanctioned Amt</th>
                            <th class="num-col">Interest %</th>
                            <th class="num-col">Tenure</th>
                            <th>EMI Start</th>
                            <th class="num-col">Monthly EMI</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>
<script>
    var disbursementsTable = null;
    var createDisbursementUrl = '@Url.Action("CreateLoanDisbursement", "Master")';

    // Seed savedLoanDisbursements from the demo JSON exactly once, then only ever read/write
    // localStorage from here on, matching the pattern used by every other prototype module.
    function seedDisbursementsIfNeeded(callback) {
        if (localStorage.getItem('savedLoanDisbursements')) {
            callback();
            return;
        }
        $.getJSON('/api-assets/loan_disbursements.json').done(function(data) {
            localStorage.setItem('savedLoanDisbursements', JSON.stringify(Array.isArray(data) ? data : []));
            callback();
        }).fail(function() {
            localStorage.setItem('savedLoanDisbursements', '[]');
            callback();
        });
    }

    function loadGridData() {
        var data = JSON.parse(localStorage.getItem('savedLoanDisbursements') || '[]');
        disbursementsTable.clear();

        var totalSanctioned = 0;
        var totalInterest = 0;

        data.forEach(function(item) {
            var sanctioned = parseFloat(item.sanctionedAmount) || 0;
            var interest = parseFloat(item.interestRate) || 0;
            var monthlyEmi = parseFloat(item.monthlyEmi) || 0;
            totalSanctioned += sanctioned;
            totalInterest += interest;

            var actionHtml = '<div class="action-btns" style="text-align:center;">' +
                '<a href="' + createDisbursementUrl + '?docNo=' + encodeURIComponent(item.disbursementNo || '') + '" title="Edit"><i class="fas fa-edit"></i></a> ' +
                '<a href="#" class="remove-item-btn" data-docno="' + (item.disbursementNo || '') + '" title="Delete"><i class="fas fa-trash-alt"></i></a>' +
                '</div>';

            disbursementsTable.row.add([
                actionHtml,
                '<strong>' + (item.disbursementNo || '-') + '</strong>',
                window.formatDateDisplay(item.disbursementDate),
                item.requestNo || '-',
                (item.employeeCode || '') + ' - ' + (item.employeeName || ''),
                item.loanTypeName || '-',
                sanctioned.toLocaleString('en-US', {minimumFractionDigits: 2}),
                interest + '%',
                (item.noOfMonths || '-') + ' Mos',
                window.formatDateDisplay(item.emiStartDate),
                monthlyEmi.toLocaleString('en-US', {minimumFractionDigits: 2}),
                '<span class="badge badge-success">' + (item.status || 'Active') + '</span>'
            ]);
        });

        $('#stat-total').text(data.length);
        $('#stat-sanctioned').text('$' + totalSanctioned.toLocaleString('en-US', {minimumFractionDigits: 2}));
        $('#stat-interest').text(data.length > 0 ? (totalInterest / data.length).toFixed(1) + '%' : '0.0%');
        $('#stat-active').text(data.length);

        disbursementsTable.draw(false);
    }

    $(document).ready(function() {
        disbursementsTable = $('#disbursements-grid').DataTable({
            pageLength: 10,
            order: [[1, 'desc']],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search disbursements..."
            },
            columnDefs: [
                { orderable: false, targets: 0 }
            ]
        });

        seedDisbursementsIfNeeded(loadGridData);

        $('#disbursements-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var docNo = $(this).data('docno');

            alertify.confirm('Are you sure you want to delete disbursement: ' + docNo + '?', function (confirmed) {
                if (confirmed) {
                    var data = JSON.parse(localStorage.getItem('savedLoanDisbursements') || '[]');
                    data = data.filter(function(r) { return r.disbursementNo !== docNo; });
                    localStorage.setItem('savedLoanDisbursements', JSON.stringify(data));
                    loadGridData();
                    alertify.log('Disbursement ' + docNo + ' deleted successfully.', 'success', 3500);
                }
            });
        });
    });
</script>
