@{
    ViewData["Title"] = "Leave Eligibility List";
}

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
<link rel="stylesheet" href="~/alertify.js/alertify.core.css" />
<link rel="stylesheet" href="~/alertify.js/alertify.default.css" />

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #data-grid thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-color: #3d5cbe;
        vertical-align: middle;
    }
    #data-grid tbody tr:hover { background-color: #f0f3ff; }
    #data-grid td {
        font-size: 0.82rem;
        color: #5a5c69;
        vertical-align: middle;
    }
    .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
    .action-btns a:hover { opacity: 0.7; }
    .action-btns .fa-edit { color: #4e73df; }
    .action-btns .fa-trash-alt { color: #e74a3b; }

    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }

    .leave-badge {
        display: inline-block;
        background-color: #eef2fd;
        color: #2e59d9;
        border: 1px solid #c2d4f8;
        border-radius: 4px;
        padding: 2px 7px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }
</style>

<div class="container-fluid py-3">

    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-user-check fa-sm"></i>
                    Leave Eligibility List
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <a href="@Url.Action("LeaveEligibility", "Master")" class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Create New
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row mb-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Records</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Leave Eligibility Entries
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-grid" class="table table-bordered table-striped table-hover" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:70px; text-align:center;">Action</th>
                            <th>Doc No</th>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Category</th>
                            <th>Duration</th>
                            <th>Remarks</th>
                            <th>Comments</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
<script src="~/alertify.js/alertify.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#data-grid').DataTable({
            "pageLength": 10,
            "order": [],
            "language": {
                search: "",
                searchPlaceholder: "Search...",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No records found"
            },
            "columnDefs": [
                { "orderable": false, "targets": 0 }
            ]
        });

        function loadGridData() {
            table.clear();
            if (!localStorage.getItem('savedLeaveEligibility')) {
                var sampleData = [
                    { docNo: 'LE-07-26-00001', date: '18-Jul-2026', employeeName: 'EMP-001 - John Smith', leaveTypeName: 'ANNUAL - Annual Leave', categoryName: 'FULLTIME - Full Time Staff', duration: '20.0', remarks: 'Annual entitlement', comments: 'Eligible balance', status: 'Active' },
                    { docNo: 'LE-07-26-00002', date: '22-Jul-2026', employeeName: 'EMP-002 - Sarah Connor', leaveTypeName: 'CASUAL - Casual Leave', categoryName: 'FULLTIME - Full Time Staff', duration: '10.0', remarks: 'Casual entitlement', comments: 'Eligible balance', status: 'Active' }
                ];
                localStorage.setItem('savedLeaveEligibility', JSON.stringify(sampleData));
            }
            var savedData = JSON.parse(localStorage.getItem('savedLeaveEligibility') || '[]');
            $('#stat-total').text(savedData.length);

            savedData.reverse().forEach(function(item, index) {
                var actualIndex = savedData.length - 1 - index;
                
                var actionHtml = `
                    <div class="action-btns" style="text-align:center;">
                        <a href="@Url.Action("LeaveEligibility", "Master")?idx=${actualIndex}" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a>
                        <a href="#" class="remove-item-btn" data-idx="${actualIndex}" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>
                    </div>
                `;

                table.row.add([
                    actionHtml,
                    item.docNo || '-',
                    item.date || '-',
                    item.employeeName || '-',
                    '<span class="leave-badge"><i class="fas fa-tag mr-1"></i>' + (item.leaveTypeName || '-') + '</span>',
                    item.categoryName || item.categoryId || '-',
                    '<span class="font-weight-bold text-primary">' + (item.duration || '0') + '</span>',
                    item.remarks || '-',
                    item.comments || '-',
                    '<span class="badge badge-success">' + (item.status || 'Active') + '</span>'
                ]);
            });
            table.draw(false);
        }

        loadGridData();

        // Edit is now a plain link straight to the LeaveEligibility page (?idx=<index>), matching
        // CreateLeaveApplication's pattern — no modal needed.

        // Delete Handler
        $('#data-grid tbody').on('click', '.remove-item-btn', function (e) {
            e.preventDefault();
            var actualIndex = $(this).data('idx');
            
            alertify.confirm('Are you sure you want to delete this record?', function (e) {
                if (e) {
                    var data = JSON.parse(localStorage.getItem('savedLeaveEligibility') || '[]');
                    data.splice(actualIndex, 1);
                    localStorage.setItem('savedLeaveEligibility', JSON.stringify(data));
                    loadGridData();
                    alertify.log('Record deleted successfully.', 'success', 5000);
                }
            });
        });
    });
</script>
