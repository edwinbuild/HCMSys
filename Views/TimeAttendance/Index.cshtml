@{
    ViewData["Title"] = "Timesheets";
    // Defensive fallback only — TimeAttendanceController.Index() always sets these from the current
    // calendar month, so this branch is normally unreachable. Computed here rather than hardcoded so
    // there's no stale reporting-period literal left in the view either.
    var todayForDefaults = DateTime.Today;
    var computedDefaultFrom = new DateTime(todayForDefaults.Year, todayForDefaults.Month, 1).ToString("yyyy-MM-dd");
    var computedDefaultTo = new DateTime(todayForDefaults.Year, todayForDefaults.Month, DateTime.DaysInMonth(todayForDefaults.Year, todayForDefaults.Month)).ToString("yyyy-MM-dd");
}

<style>
    html { font-size: 14px; }

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .page-title-bar .page-title-text {
        font-size: 0.95rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title-bar .page-title-text i { color: #4e73df; }
    .page-title-bar .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Stat Cards */
    .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
    .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
    .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
    .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }

    /* Filters Bar */
    .filter-card {
        background-color: #f8f9fc;
        border: 1px solid #e3e6f0;
        border-radius: 0.35rem;
        padding: 12px 16px;
        margin-bottom: 16px;
    }
    .filter-card label {
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6e707e;
        margin-bottom: 4px;
    }

    /* Table Styling */
    #tblTimesheets {
        width: 100% !important;
        border-collapse: collapse;
    }
    #tblTimesheets thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-color: #3d5cbe;
        vertical-align: middle;
        white-space: nowrap;
        padding: 10px 12px;
    }
    #tblTimesheets tbody tr:hover {
        background-color: #f0f4ff;
    }
    #tblTimesheets td {
        font-size: 0.82rem;
        color: #4a4c59;
        vertical-align: middle;
        padding: 8px 12px;
    }

    /* Custom Badges */
    .member-code-badge {
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        background-color: #eaecf4;
        color: #4e73df;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #d1d3e2;
        white-space: nowrap;
    }
    .badge-time-in {
        background-color: #e6f9f0;
        color: #1cc88a;
        border: 1px solid #b7eed6;
        font-weight: 600;
        font-size: 0.76rem;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
        white-space: nowrap;
    }
    .badge-time-out {
        background-color: #eaf3ff;
        color: #4e73df;
        border: 1px solid #c2d9ff;
        font-weight: 600;
        font-size: 0.76rem;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
        white-space: nowrap;
    }
    .badge-worked-hours {
        background-color: #4e73df;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
        white-space: nowrap;
    }
    .badge-worked-zero {
        background-color: #eaecf4;
        color: #858796;
        font-weight: 500;
        font-size: 0.75rem;
        padding: 3px 7px;
        border-radius: 4px;
        display: inline-block;
    }
    .badge-absence-off {
        background-color: #fef5e7;
        color: #f6c23e;
        border: 1px solid #f9e2b1;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 2px 7px;
        border-radius: 4px;
        display: inline-block;
    }
    .badge-absence-rest {
        background-color: #f4f6f9;
        color: #6c757d;
        border: 1px solid #dee2e6;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 2px 7px;
        border-radius: 4px;
        display: inline-block;
    }
    .badge-absence-absent {
        background-color: #fde8e8;
        color: #e74a3b;
        border: 1px solid #f8b4b4;
        font-weight: 600;
        font-size: 0.75rem;
        padding: 2px 7px;
        border-radius: 4px;
        display: inline-block;
    }

    .source-api-badge {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
        color: #fff;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .loading-overlay {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        color: #4e73df;
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div>
                    <div class="page-title-text">
                        <i class="fas fa-calendar-check fa-sm"></i>
                        Time & Attendance &mdash; Timesheets
                        <span class="source-api-badge shadow-sm ml-2">
                            <i class="fas fa-bolt fa-xs"></i> Jibble Live API
                        </span>
                    </div>
                    <small class="text-muted">Real-time attendance, tracked hours, and absence synchronization for the selected date range</small>
                </div>
                <div class="btn-group-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-sm shadow-sm">
                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i> Home
                    </a>
                    <button type="button" class="btn btn-info btn-sm shadow-sm" id="btn-refresh" onclick="loadTimesheetData(true)">
                        <i class="fas fa-sync-alt fa-sm text-white-50 mr-1"></i> Refresh API
                    </button>
                    <button type="button" class="btn btn-success btn-sm shadow-sm" id="btn-export-excel" onclick="exportExcel()">
                        <i class="fas fa-file-excel fa-sm text-white-50 mr-1"></i> Export to Excel (.xlsx)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT SUMMARY CARDS (3 Cards: Total Worked Hours removed as requested) -->
    <div class="row mb-3">
        <div class="col-xl-4 col-md-4 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Records</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-records">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Active Members</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-members">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Absences & Time Off</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total-absences">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER CARD (Date Range, Employee, Department, Status, Absence Only) -->
    <div class="card shadow mb-4">
        <div class="card-body py-3">
            <div class="row align-items-end">
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                    <label class="font-weight-bold text-uppercase text-xs text-muted mb-1">From Date</label>
                    <div class="input-group input-group-sm">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                        </div>
                        <input type="date" class="form-control form-control-sm" id="filter-from-date" value="@(ViewBag.DefaultFromDate ?? computedDefaultFrom)" />
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                    <label class="font-weight-bold text-uppercase text-xs text-muted mb-1">To Date</label>
                    <div class="input-group input-group-sm">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-calendar-day"></i></span>
                        </div>
                        <input type="date" class="form-control form-control-sm" id="filter-to-date" value="@(ViewBag.DefaultToDate ?? computedDefaultTo)" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6 mb-2">
                    <label class="font-weight-bold text-uppercase text-xs text-muted mb-1">Employee</label>
                    <select class="form-control form-control-sm" id="filter-employee">
                        <option value="">All Employees</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6 mb-2">
                    <label class="font-weight-bold text-uppercase text-xs text-muted mb-1">Department</label>
                    <select class="form-control form-control-sm" id="filter-department">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6 mb-2">
                    <label class="font-weight-bold text-uppercase text-xs text-muted mb-1">Status</label>
                    <select class="form-control form-control-sm" id="filter-status">
                        <option value="">All Statuses</option>
                        <option value="Worked">Worked</option>
                        <option value="Rest Day">Rest Day</option>
                        <option value="Time Off">Time Off</option>
                        <option value="Absent">Absent</option>
                    </select>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12 mb-2 d-flex align-items-center">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="filter-only-absence">
                        <label class="custom-control-label font-weight-bold text-xs text-danger cursor-pointer" for="filter-only-absence">
                            <i class="fas fa-user-clock mr-1"></i> Absence & Time Off Only
                        </label>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12 mb-2 d-flex justify-content-end align-items-center" style="gap: 8px;">
                    <button type="button" class="btn btn-secondary btn-sm shadow-sm" id="btn-reset-filters" onclick="resetFilters()">
                        <i class="fas fa-undo fa-sm mr-1"></i> Reset Filters
                    </button>
                    <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btn-apply-filters" onclick="applyFilters()">
                        <i class="fas fa-filter fa-sm mr-1"></i> Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN DATA TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-1"></i> Timesheet Records Grid
            </h6>
            <div class="d-flex align-items-center" style="gap: 6px;">
                <span class="badge badge-light text-muted font-weight-normal" id="lbl-active-range"></span>
                <span class="badge badge-light text-muted font-weight-normal" id="lbl-records-count">Loading data from Jibble...</span>
            </div>
        </div>
        <div class="card-body p-2 p-md-3">
            <div id="grid-loading" class="loading-overlay">
                <div class="spinner-border text-primary mb-3" style="width: 3.2rem; height: 3.2rem;" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <h5 class="font-weight-bold text-primary mb-1">Querying Jibble Live API</h5>
                <p class="text-muted small mb-2" id="loading-status-text">
                    <i class="fas fa-satellite-dish mr-1 text-info"></i> Connecting to identity.prod.jibble.io & time-attendance.prod.jibble.io...
                </p>
                <div class="badge badge-light border px-3 py-1 font-weight-normal text-muted" id="loading-timer">
                    <i class="far fa-clock mr-1"></i> Direct Jibble live query (no mock/fallback)
                </div>
            </div>

            <div class="table-responsive" id="table-wrapper" style="display:none;">
                <table class="table table-bordered table-hover" id="tblTimesheets">
                    <thead>
                        <tr>
                            <!-- EXACT 12 COLUMNS AS SPECIFIED: Date, Day, Full Name, Member Code, Position, Department, Manager(s), First In, Last Out, Worked Hours, Absence, Justification -->
                            <th>Date</th>
                            <th>Day</th>
                            <th>Full Name</th>
                            <th>Member Code</th>
                            <th>Position</th>
                            <th>Department</th>
                            <th>Manager(s)</th>
                            <th>First In</th>
                            <th>Last Out</th>
                            <th>Worked Hours</th>
                            <th>Absence</th>
                            <th>Justification</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Populated by DataTables via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Page Script -->
<script>
    var timesheetTable = null;
    var allRowsData = [];
    var loadTimerInterval = null;
    var loadSecondsElapsed = 0;
    var defaultFromDate = '@(ViewBag.DefaultFromDate ?? computedDefaultFrom)';
    var defaultToDate = '@(ViewBag.DefaultToDate ?? computedDefaultTo)';
    // Tracks the date range actually loaded into allRowsData right now, so we only go back to the
    // server when the requested range changes, instead of re-fetching on every filter tweak.
    var loadedFromDate = null;
    var loadedToDate = null;

    $(document).ready(function() {
        initDataTable();
        loadTimesheetData(false);

        // Employee/Department/Status/Absence are pure client-side filters over whatever date range is
        // already loaded, so they can re-filter instantly on change. From/To Date changes the actual
        // dataset that needs to be fetched, so they're intentionally left out here and only take effect
        // when "Apply Filters" is clicked (see applyFilters()) — that avoids firing a Jibble API call on
        // every keystroke/click inside the date pickers.
        $('#filter-employee, #filter-department, #filter-status, #filter-only-absence').on('change', function() {
            applyClientSideFilters();
        });
    });

    function startLoadingUI() {
        clearInterval(loadTimerInterval);
        loadSecondsElapsed = 0;
        $('#grid-loading').show();
        $('#table-wrapper').hide();
        $('#btn-refresh').prop('disabled', true).find('i').addClass('fa-spin');
        $('#lbl-records-count').text('Connecting to Jibble live API...');
        $('#loading-status-text').html('<i class="fas fa-key mr-1 text-info"></i> Authenticating with Jibble OAuth2 service...');
        $('#loading-timer').html('<i class="far fa-clock mr-1"></i> Elapsed: 0s &bull; Direct Jibble live API query');

        loadTimerInterval = setInterval(function() {
            loadSecondsElapsed++;
            $('#loading-timer').html('<i class="far fa-clock mr-1"></i> Elapsed: ' + loadSecondsElapsed + 's &bull; Direct Jibble live API query');

            if (loadSecondsElapsed === 2) {
                $('#loading-status-text').html('<i class="fas fa-cloud-download-alt mr-1 text-primary"></i> Downloading timesheets for the selected date range...');
            } else if (loadSecondsElapsed === 8) {
                $('#loading-status-text').html('<i class="fas fa-calculator mr-1 text-warning"></i> Aggregating attendance, time off, and tracked hours...');
            } else if (loadSecondsElapsed >= 14) {
                $('#loading-status-text').html('<i class="fas fa-stream mr-1 text-success"></i> Finalizing and parsing daily attendance records...');
            }
        }, 1000);
    }

    function stopLoadingUI() {
        clearInterval(loadTimerInterval);
        $('#btn-refresh').prop('disabled', false).find('i').removeClass('fa-spin');
        $('#grid-loading').hide();
        $('#table-wrapper').show();
    }

    function initDataTable() {
        if ($.fn.DataTable && $.fn.DataTable.isDataTable('#tblTimesheets')) {
            try { $('#tblTimesheets').DataTable().destroy(); } catch(e) {}
        }

        if ($.fn.DataTable) {
            timesheetTable = $('#tblTimesheets').DataTable({
                deferRender: true,
                // Order by Date ascending (col 0), then by Full Name ascending (col 2)
                order: [[0, 'asc'], [2, 'asc']],
                pageLength: 25,
                lengthMenu: [[15, 25, 50, 100, 250, -1], [15, 25, 50, 100, 250, "All"]],
                language: {
                    search: "",
                    searchPlaceholder: "Search any field...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ timesheets",
                    emptyTable: "No timesheet records found for selected period",
                    zeroRecords: "No matching records found"
                },
                columnDefs: [
                    { className: "font-weight-bold text-nowrap", targets: 0 },
                    { className: "text-nowrap", targets: [1, 3, 7, 8, 9, 10] },
                    { className: "text-center", targets: [3, 7, 8, 9] },
                    { targets: 11, width: "220px" }
                ]
            });
        }
    }

    function loadTimesheetData(forceRefresh) {
        var fromDateVal = $('#filter-from-date').val() || defaultFromDate;
        var toDateVal = $('#filter-to-date').val() || defaultToDate;

        startLoadingUI();

        $.ajax({
            url: '@Url.Action("GetTimesheetData", "TimeAttendance")',
            type: 'GET',
            data: {
                fromDate: fromDateVal,
                toDate: toDateVal,
                forceRefresh: forceRefresh === true
            },
            dataType: 'json',
            timeout: 90000,
            success: function(res) {
                try {
                    if (res && res.success && Array.isArray(res.data)) {
                        allRowsData = res.data;
                        loadedFromDate = fromDateVal;
                        loadedToDate = toDateVal;
                        updateActiveRangeBadge();
                        populateFilters(allRowsData);
                        applyClientSideFilters();

                        if (typeof alertify !== 'undefined' && forceRefresh) {
                            alertify.log('Successfully refreshed ' + allRowsData.length.toLocaleString() + ' records from Jibble API.', 'success', 3500);
                        }
                        // Surface any non-fatal degradation (e.g. managers or notes couldn't be fully
                        // fetched) even though the main grid did load, instead of failing silently.
                        if (typeof alertify !== 'undefined' && Array.isArray(res.warnings)) {
                            res.warnings.forEach(function(w) {
                                alertify.log(w, 'warning', 6000);
                            });
                        }
                    } else {
                        allRowsData = [];
                        renderGridRows([]);
                        updateStatCards([]);
                        var errMsg = (res && res.message) ? res.message : 'No data returned from Jibble API.';
                        $('#lbl-records-count').text('0 records found');
                        if (typeof alertify !== 'undefined') {
                            alertify.log(errMsg, 'error', 5000);
                        }
                    }
                } catch(renderEx) {
                    console.error('Error rendering rows:', renderEx);
                } finally {
                    stopLoadingUI();
                }
            },
            error: function(xhr, status, error) {
                stopLoadingUI();
                allRowsData = [];
                renderGridRows([]);
                updateStatCards([]);
                var errMsg = 'Failed to load from Jibble API: ' + (error || status);
                $('#lbl-records-count').text('Error loading data');
                if (typeof alertify !== 'undefined') {
                    alertify.log(errMsg, 'error', 5000);
                }
            }
        });
    }

    // Formats a 'yyyy-MM-dd' input value as 'dd-MMM-yyyy' (matching the grid's own date column) without
    // going through the Date object, so there's no local-timezone off-by-one risk on the display.
    function formatDateDisplay(isoDate) {
        var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var parts = (isoDate || '').split('-');
        if (parts.length !== 3) return isoDate || '';
        var y = parts[0], m = parseInt(parts[1], 10), d = parts[2];
        if (!m || m < 1 || m > 12) return isoDate;
        return d + '-' + monthNames[m - 1] + '-' + y;
    }

    function updateActiveRangeBadge() {
        if (!loadedFromDate || !loadedToDate) {
            $('#lbl-active-range').text('');
            return;
        }
        $('#lbl-active-range').html('<i class="fas fa-calendar-alt mr-1"></i>' + formatDateDisplay(loadedFromDate) + ' &ndash; ' + formatDateDisplay(loadedToDate));
    }

    // Called by the "Apply Filters" button. Employee/Department/Status/Absence are always applied
    // client-side against whatever is already loaded, but From/To Date defines *what* needs to be loaded
    // in the first place — if it no longer matches the currently loaded range (e.g. the user extended it
    // into another month), fetch that range from the server first instead of silently filtering stale data.
    function applyFilters() {
        var fromDateVal = $('#filter-from-date').val() || defaultFromDate;
        var toDateVal = $('#filter-to-date').val() || defaultToDate;

        if (fromDateVal !== loadedFromDate || toDateVal !== loadedToDate) {
            loadTimesheetData(false);
        } else {
            applyClientSideFilters();
        }
    }

    // Member Code uniquely identifies an employee in Jibble; Full Name does not (two employees can share
    // a name). Use Member Code as the filter/grouping key whenever it's available, only falling back to
    // Full Name for the rare row where no code was resolved, so employees with duplicate names don't get
    // merged into a single filter entry or matched against each other.
    function getEmployeeKey(r) {
        return (r.memberCode && r.memberCode !== '-') ? r.memberCode : r.fullName;
    }

    function populateFilters(rows) {
        var deptSet = new Set();
        var empMap = new Map(); // key -> { name, code }

        rows.forEach(function(r) {
            if (r.department && r.department !== '-') {
                deptSet.add(r.department);
            }
            if (r.fullName && r.fullName !== 'Unknown' && r.fullName !== '-') {
                var key = getEmployeeKey(r);
                if (!empMap.has(key)) {
                    empMap.set(key, { name: r.fullName, code: r.memberCode || '' });
                }
            }
        });

        // Populate Department dropdown
        var currentDept = $('#filter-department').val();
        var deptSelect = $('#filter-department');
        deptSelect.empty().append('<option value="">All Departments</option>');
        Array.from(deptSet).sort().forEach(function(d) {
            deptSelect.append(`<option value="${d}">${d}</option>`);
        });
        if (currentDept && deptSet.has(currentDept)) {
            deptSelect.val(currentDept);
        }

        // Populate Employee dropdown (sorted by display name, valued by the unique key)
        var currentEmp = $('#filter-employee').val();
        var empSelect = $('#filter-employee');
        empSelect.empty().append('<option value="">All Employees</option>');
        Array.from(empMap.keys())
            .sort(function(a, b) { return empMap.get(a).name.localeCompare(empMap.get(b).name); })
            .forEach(function(key) {
                var info = empMap.get(key);
                var label = info.code && info.code !== '-' ? `${info.name} (${info.code})` : info.name;
                empSelect.append(`<option value="${key}">${label}</option>`);
            });
        if (currentEmp && empMap.has(currentEmp)) {
            empSelect.val(currentEmp);
        }
    }

    function applyClientSideFilters() {
        var fromDate = $('#filter-from-date').val();
        var toDate = $('#filter-to-date').val();
        var selectedEmp = $('#filter-employee').val();
        var selectedDept = $('#filter-department').val();
        var selectedStatus = $('#filter-status').val();
        var onlyAbsence = $('#filter-only-absence').is(':checked');

        var filtered = allRowsData.filter(function(r) {
            if (fromDate && r.date < fromDate) return false;
            if (toDate && r.date > toDate) return false;
            if (selectedEmp && getEmployeeKey(r) !== selectedEmp) return false;
            if (selectedDept && r.department !== selectedDept) return false;
            if (selectedStatus && r.statusBadge !== selectedStatus) return false;
            if (onlyAbsence && !r.isAbsenceOrTimeOff) return false;
            return true;
        });

        renderGridRows(filtered);
        updateStatCards(filtered);
    }

    function resetFilters() {
        $('#filter-from-date').val(defaultFromDate);
        $('#filter-to-date').val(defaultToDate);
        $('#filter-employee').val('');
        $('#filter-department').val('');
        $('#filter-status').val('');
        $('#filter-only-absence').prop('checked', false);
        // Route through applyFilters() rather than filtering directly: if the grid currently has a
        // different range loaded (e.g. the user had extended it into another month), resetting the date
        // inputs needs to re-fetch the default range too, not just re-filter whatever is still in memory.
        applyFilters();
    }

    function renderGridRows(rows) {
        if (!timesheetTable && $.fn.DataTable) {
            initDataTable();
        }

        var dataSet = rows.map(function(r) {
            // Member Code Badge
            var memberCodeHtml = (r.memberCode && r.memberCode !== '-')
                ? `<span class="member-code-badge">${r.memberCode}</span>`
                : `<span class="text-muted">-</span>`;

            // First In
            var firstInHtml = (r.firstIn && r.firstIn !== '-')
                ? `<span class="badge-time-in"><i class="fas fa-sign-in-alt mr-1"></i>${r.firstIn}</span>`
                : `<span class="text-muted">-</span>`;

            // Last Out
            var lastOutHtml = (r.lastOut && r.lastOut !== '-')
                ? `<span class="badge-time-out"><i class="fas fa-sign-out-alt mr-1"></i>${r.lastOut}</span>`
                : `<span class="text-muted">-</span>`;

            // Worked Hours
            var workedHoursHtml = '';
            if (r.workedHours && r.workedHours !== '0h 0m' && r.workedHours !== '-') {
                workedHoursHtml = `<span class="badge-worked-hours"><i class="fas fa-clock mr-1"></i>${r.workedHours}</span>`;
            } else {
                workedHoursHtml = `<span class="badge-worked-zero">0h 0m</span>`;
            }

            // Absence Badge
            var absenceHtml = '';
            if (r.absence && r.absence !== '-') {
                if (r.absence.indexOf('Rest') !== -1) {
                    absenceHtml = `<span class="badge-absence-rest"><i class="fas fa-bed mr-1"></i>${r.absence}</span>`;
                } else if (r.absence.indexOf('Absent') !== -1) {
                    absenceHtml = `<span class="badge-absence-absent"><i class="fas fa-user-times mr-1"></i>${r.absence}</span>`;
                } else {
                    absenceHtml = `<span class="badge-absence-off"><i class="fas fa-umbrella-beach mr-1"></i>${r.absence}</span>`;
                }
            } else {
                absenceHtml = `<span class="text-muted">-</span>`;
            }

            // Justification
            var justificationHtml = '';
            if (r.justification && r.justification !== '-') {
                justificationHtml = `<div class="p-1 px-2 border rounded bg-light text-dark text-xs" dir="auto" style="white-space: normal; line-height: 1.35; max-width: 250px; font-weight: 500;">${r.justification}</div>`;
            } else {
                justificationHtml = `<span class="text-muted">-</span>`;
            }

            return [
                `<span data-order="${r.date}">${r.formattedDate || r.date}</span>`,
                r.day || '-',
                `<strong>${r.fullName}</strong>`,
                memberCodeHtml,
                r.position || '-',
                r.department || '-',
                r.managers || '-',
                firstInHtml,
                lastOutHtml,
                workedHoursHtml,
                absenceHtml,
                justificationHtml
            ];
        });

        if (timesheetTable) {
            timesheetTable.clear();
            timesheetTable.rows.add(dataSet);
            timesheetTable.draw(false);
            setTimeout(function() {
                try { timesheetTable.columns.adjust(); } catch(e) {}
            }, 50);
        } else {
            // Fallback plain DOM rendering if DataTables is unavailable
            var tbody = $('#tblTimesheets tbody');
            tbody.empty();
            dataSet.forEach(function(row) {
                var tr = '<tr>' + row.map(function(col) { return '<td>' + col + '</td>'; }).join('') + '</tr>';
                tbody.append(tr);
            });
        }

        $('#lbl-records-count').text(rows.length.toLocaleString() + ' entries displayed');
    }

    function updateStatCards(rows) {
        var membersSet = new Set();
        var absenceCount = 0;

        rows.forEach(function(r) {
            if (r.fullName && r.fullName !== 'Unknown' && r.fullName !== '-') {
                membersSet.add(getEmployeeKey(r));
            }
            if (r.isAbsenceOrTimeOff) {
                absenceCount++;
            }
        });

        $('#stat-total-records').text(rows.length.toLocaleString());
        $('#stat-total-members').text(membersSet.size);
        $('#stat-total-absences').text(absenceCount.toLocaleString());
    }

    function exportExcel() {
        var fromDate = $('#filter-from-date').val() || defaultFromDate;
        var toDate = $('#filter-to-date').val() || defaultToDate;
        var employee = $('#filter-employee').val() || '';
        var department = $('#filter-department').val() || '';
        var status = $('#filter-status').val() || '';
        var onlyAbsence = $('#filter-only-absence').is(':checked');

        var params = new URLSearchParams({
            fromDate: fromDate,
            toDate: toDate,
            employee: employee,
            department: department,
            status: status,
            onlyAbsence: onlyAbsence
        });

        window.location.href = '@Url.Action("ExportTimesheetExcel", "TimeAttendance")' + '?' + params.toString();
    }
</script>
